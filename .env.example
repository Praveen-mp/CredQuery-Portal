AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# Use a READ-ONLY database user for each of these if at all possible.
POSTGRES_URI=postgresql+psycopg2://readonly_user:password@host:5432/dbname
MYSQL_URI=mysql+pymysql://readonly_user:password@host:3306/dbname
MONGODB_URI=mongodb://readonly_user:password@host:27017
MONGODB_DB_NAME=dbname
