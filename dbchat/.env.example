# The ONLY thing configured outside the app itself. Everything else (database
# connections, LLM provider credentials) is set up through the in-app Setup
# wizard after first launch, encrypted with this key, and stored in the
# app's own local metadata database.
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Back this up like a database password. Losing it makes every stored
# connection and credential unrecoverable.
APP_SECRET_KEY=

# Optional — override where the app's metadata (connections, LLM config) is
# stored. Defaults to ./dbchat_metadata.db. The Docker image sets this to a
# mounted volume automatically; you don't need to touch it for local runs.
# METADATA_DB_PATH=dbchat_metadata.db

# Optional — per-session chat rate limit.
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=60
